# Auth DB source (staff metadata)
AUTH_DB_HOST=localhost
AUTH_DB_PORT=3306
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=your_auth_password
AUTH_DB_NAME=auth_db

# Core DB source (attendance data)
CORE_DB_HOST=localhost
CORE_DB_PORT=3306
CORE_DB_USER=core_user
CORE_DB_PASSWORD=your_core_password
CORE_DB_NAME=core_db

# LLM provider config
LLM_PROVIDER=chutes
CHUTES_API_KEY=your_chutes_api_key
CHUTES_MODEL=Qwen/Qwen3.6-27B-TEE
CHUTES_BASE_URL=https://llm.chutes.ai/v1

# Backward-compatible OpenRouter config (optional if LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# Orchestrator routing threshold
CLASSIFIER_CONFIDENCE_THRESHOLD=0.6

# Startup bootstrap and ETL schedule
CHAT_SERVICE_BOOTSTRAP_ENABLED=true
MOCK_DATA_SEED_ON_STARTUP=true
HR_ETL_SCHEDULE_SECONDS=300
