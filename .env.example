# Copy to .env for local Docker Compose. Do not commit real .env files.

# Shared JWT signing key for auth-service and api-gateway.
# Replace before running outside local development.
# Generate one with: openssl rand -hex 64
SIGNED_KEY=local-dev-only-change-me-signed-key-minimum-64-bytes-for-hs512-001

# Auth token lifetime settings.
# Access token TTL is the lifetime of each issued token.
# Sliding session TTL is the absolute max lifetime of a login session across refresh rotations.
JWT_ACCESS_TOKEN_TTL_SECONDS=86400
JWT_SLIDING_SESSION_TTL_SECONDS=86400

# Auth database
AUTH_DB_HOST_PORT=3307
AUTH_DB_ROOT_PASSWORD=local-dev-auth-root-password
AUTH_DB_NAME=auth_db
AUTH_DB_USERNAME=auth_user
AUTH_DB_PASSWORD=local-dev-auth-db-password

# Core database
CORE_DB_HOST_PORT=3308
CORE_DB_ROOT_PASSWORD=local-dev-core-root-password
CORE_DB_NAME=core_db
CORE_DB_USERNAME=core_user
CORE_DB_PASSWORD=local-dev-core-db-password
DB_TIMEZONE=Asia/Ho_Chi_Minh
JPA_DDL_AUTO=update

# Internal M2M JWT config for AI service -> core-service.
# This is separate from SIGNED_KEY used by user/admin login JWT.
INTERNAL_JWT_SIGNED_KEY=local-dev-only-change-me-internal-key-minimum-64-bytes-for-hs512-001
INTERNAL_JWT_ISSUER=ai-service
INTERNAL_JWT_AUDIENCE=core-service
INTERNAL_JWT_REQUIRED_SCOPE=attendance:sync

# Service discovery and internal URLs
EUREKA_HOST_PORT=8761
API_GATEWAY_HOST_PORT=8080
AUTH_SERVICE_HOST_PORT=8081
CORE_SERVICE_HOST_PORT=8082
FRONTEND_HOST_PORT=3000
FRONTEND_SERVER_NAME=_
EUREKA_URL=http://eureka-service:8761/eureka/
AUTH_INTROSPECT_URL=http://auth-service:8081/auth/introspect
FRONTEND_API_GATEWAY_URL=http://api-gateway:8080

# Local seed admin. Disable or rotate immediately for non-local environments.
SEED_ADMIN_ENABLED=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=local-dev-admin-password
SEED_ADMIN_STAFF_ID=SYS000001

# E2E credentials. E2E_USER_PASSWORD must match the password convention
# generated from E2E_USER_DOB in auth.setup.ts.
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=local-dev-admin-password
E2E_USER_EMAIL=e2e_test_user@example.com
E2E_USER_DOB=1998-03-20
E2E_USER_PASSWORD=20031998
E2E_CORE_INTERNAL_BASE_URL=http://core-service:8082

# Runtime logging
AUTH_LOG_LEVEL=INFO
CORE_LOG_LEVEL=INFO
GATEWAY_LOG_LEVEL=INFO
